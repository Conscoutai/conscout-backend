# Lite product deployment: Lite mobile application only.
APP_SURFACE=lite
MONGO_URI=<lite-database-user-connection-string>
DB_NAME=construction_ai_lite
# Shared dedicated admin directory; Lite customer accounts remain in DB_NAME.
ADMIN_DB_NAME=construction_ai_admin
DATA_DIR=/app/data-lite
# Native mobile apps do not require CORS, but add a Lite web origin here if one
# is introduced later.
ALLOWED_ORIGINS=https://lite.conscout.com

# Moyasar subscription checkout. Start with pk_test_/sk_test_ credentials and
# switch to live credentials only after the complete test checklist passes.
PUBLIC_API_BASE_URL=https://api.conscout.com
SUBSCRIPTION_PAYMENT_CURRENCY=USD
MOYASAR_PUBLISHABLE_KEY=pk_test_replace_me
MOYASAR_SECRET_KEY=sk_test_replace_me
MOYASAR_WEBHOOK_SECRET=replace_with_a_long_random_value
MOYASAR_APPLE_PAY_COUNTRY=SA
MOYASAR_APPLE_PAY_LABEL=ConScout
SUBSCRIPTION_RENEWAL_SCHEDULER_ENABLED=false
SUBSCRIPTION_RENEWAL_POLL_SECONDS=300
SUBSCRIPTION_RENEWAL_MAX_RETRIES=3

# Add the Lite product's Google, Firebase, SMTP, and AI variables.
# Do not set ENABLE_LEGACY_BOOTSTRAP_MIGRATION.
